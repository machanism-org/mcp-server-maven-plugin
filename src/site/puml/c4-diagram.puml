' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.
@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()
title C4 Component diagram for MCP Server Maven Plugin

Person(developer, "Build engineer", "Invokes a Maven goal and connects an MCP client to the running server")
System_Ext(maven, "Maven Runtime", "Executes the selected aggregator goal")
System_Ext(mavenProject, "Maven Project", "Supplies project name, version, and base directory")
System_Ext(mcpConfigFile, "MCP Configuration File", "Supplies the configuration used to configure MCP tools")
System_Ext(mcpClients, "MCP Clients", "Call the stateless or streamable HTTP MCP endpoint")
Component_Ext(mcpLibrary, "Machai MCP Server Library", "Java library", "Provides server implementations, configuration loading, and MCP tool hosting")
System_Ext(jvm, "Java Virtual Machine", "Hosts the server process and performs a requested process exit")

Container_Boundary(plugin, "MCP Server Maven Plugin") {
  Component(abstractMojo, "AbstractMCPServerMojo", "Abstract Maven Mojo", "Reads shared Maven parameters, applies configured system properties, and loads the PropertiesConfigurator")
  Component(statelessMojo, "HttpStatelessServerMojo", "Maven Mojo", "Creates and configures a stateless HTTP server, registers configured tools, and starts it")
  Component(streamableMojo, "HttpStreamableMcpServerMojo", "Maven Mojo", "Creates and configures a streamable HTTP server, registers configured tools, and starts it")
  Component(serverTools, "MCPServerTools", "FunctionTools provider", "Exposes stop_mcp_server, logs final usage, and initiates delayed JVM shutdown")
}

Rel(developer, maven, "Invokes stateless or streamable goal")
Rel(developer, mcpClients, "Uses to call server")
Rel(maven, statelessMojo, "Executes")
Rel(maven, streamableMojo, "Executes")
Rel(statelessMojo, abstractMojo, "Extends")
Rel(streamableMojo, abstractMojo, "Extends")
Rel(abstractMojo, mavenProject, "Reads project and build directory parameters")
Rel(abstractMojo, mcpConfigFile, "Loads configuration path from")
Rel(abstractMojo, mcpLibrary, "Loads PropertiesConfigurator through")
Rel(abstractMojo, jvm, "Applies supplied parameters as system properties")
Rel(statelessMojo, mcpLibrary, "Creates, configures, and starts stateless server")
Rel(streamableMojo, mcpLibrary, "Creates, configures, and starts streamable server")
Rel(mcpLibrary, serverTools, "Hosts configured FunctionTools")
Rel(mcpClients, mcpLibrary, "Calls selected MCP endpoint", "HTTP")
Rel(serverTools, jvm, "Exits with requested code after delay and usage logging")

SHOW_LEGEND()
@enduml
