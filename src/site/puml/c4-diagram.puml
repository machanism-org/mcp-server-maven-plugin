' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.
@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()
title C4 Component diagram for MCP Server Maven Plugin

Person(developer, "Build engineer", "Invokes a Maven goal and connects an MCP client to the running server")
System_Ext(maven, "Maven Runtime", "Creates and executes the selected aggregator goal")
System_Ext(mavenProject, "Maven Project", "Supplies project name, version, base directory, and Maven settings")
System_Ext(mcpConfigFile, "MCP Configuration File", "Supplies the configuration used to discover and configure MCP tools")
System_Ext(mcpClients, "MCP Clients", "Call the selected stateless or streamable HTTP MCP endpoint")
System_Ext(mcpLibrary, "Machai MCP Server Library", "Provides MCP server implementations, configuration loading, and tool hosting")
System_Ext(jvm, "Java Virtual Machine", "Hosts the server process and performs the requested exit")

System_Boundary(plugin, "MCP Server Maven Plugin") {
  Component(statelessMojo, "HttpStatelessServerMojo", "Maven Mojo", "Applies shared configuration, creates a stateless HTTP server, registers tools, and starts it")
  Component(streamableMojo, "HttpStreamableMcpServerMojo", "Maven Mojo", "Applies shared configuration, creates a streamable HTTP server, registers tools, and starts it")
  Component(abstractMojo, "AbstractMCPServerMojo", "Abstract Maven Mojo", "Provides Maven parameters, applies system properties, and loads the PropertiesConfigurator")
  Component(serverTools, "MCPServerTools", "FunctionTools", "Exposes stop_mcp_server, records final usage, and performs delayed JVM shutdown")
}

Rel(developer, maven, "Invokes stateless or streamable goal")
Rel(developer, mcpClients, "Uses to call server")
Rel(maven, statelessMojo, "Executes")
Rel(maven, streamableMojo, "Executes")
Rel(statelessMojo, abstractMojo, "Extends")
Rel(streamableMojo, abstractMojo, "Extends")
Rel(abstractMojo, mavenProject, "Reads project context from")
Rel(abstractMojo, mcpConfigFile, "Loads configuration from")
Rel(abstractMojo, mcpLibrary, "Obtains PropertiesConfigurator from")
Rel(abstractMojo, jvm, "Sets configured system properties on")
Rel(statelessMojo, mcpLibrary, "Creates, configures, and starts stateless server")
Rel(streamableMojo, mcpLibrary, "Creates, configures, and starts streamable server")
Rel(statelessMojo, serverTools, "Makes lifecycle tools available")
Rel(streamableMojo, serverTools, "Makes lifecycle tools available")
Rel(mcpLibrary, serverTools, "Discovers and hosts configured tools")
Rel(mcpClients, mcpLibrary, "Calls selected HTTP MCP endpoint", "HTTP")
Rel(serverTools, jvm, "Logs usage and exits after delay")

SHOW_LEGEND()
@enduml
